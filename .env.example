# ──────────────────────────────────────────────────────────────────────────
# Fireworks AI API Key
#
# Copy this file to .env and replace the placeholder with your real key:
#   cp .env.example .env
#   # Then edit .env and paste your key
#
# NEVER commit .env to git. It is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────

FIREWORKS_API_KEY=fw_YOUR_API_KEY_HERE

# Optional: Override the base URL (defaults to https://api.fireworks.ai)
# FIREWORKS_BASE_URL=https://api.fireworks.ai
